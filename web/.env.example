# Copy to .env.local. Your own WalletConnect project id, from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Only for layout checks: builds the /preview fixture page. Leave unset for a real build.
# NEXT_PUBLIC_PREVIEW=1
# The public address of the deployed site, used for share images and preview tags. A production build fails without it
# (or Vercel's VERCEL_PROJECT_PRODUCTION_URL) and fails if it is localhost.
NEXT_PUBLIC_SITE_URL=
