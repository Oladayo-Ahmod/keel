{
  "name": "@trozu/sdk",
  "version": "0.1.0",
  "description": "Read Trozu positions, listings and guardians, and build unsigned transactions. Never signs.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:matsnet": "MATSNET=1 vitest run test/matsnet.test.ts"
  },
  "dependencies": {
    "viem": "2.57.10"
  }
}
