    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "dry-run": "node dist/cli.js --dry-run",
    "test": "vitest run"
  },
  "dependencies": {
    "@trozu/sdk": "0.1.0",
    "viem": "2.57.10"
  }
}
